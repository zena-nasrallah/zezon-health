<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zezon_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layout_signup_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner: app name, title and subtitle -->
        <FrameLayout
            android:id="@+id/layout_signup_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header">

            <ImageView
                android:id="@+id/img_snowflake_banner"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="28dp"
                android:layout_marginTop="36dp"
                android:alpha="0.8"
                android:contentDescription="@string/decor_desc"
                android:src="@drawable/ic_snowflake" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp"
                android:paddingEnd="24dp"
                android:paddingStart="24dp"
                android:paddingTop="48dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_logo_heart"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_heart" />

                    <TextView
                        android:id="@+id/tv_app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/app_name"
                        android:textColor="@color/zezon_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_signup_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/signup_title"
                    android:textColor="@color/zezon_navy"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_signup_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/signup_subtitle"
                    android:textColor="@color/zezon_navy"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Form -->
        <LinearLayout
            android:id="@+id/layout_signup_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp">

            <EditText
                android:id="@+id/et_full_name"
                style="@style/Zezon.Input"
                android:hint="@string/hint_full_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/et_email"
                style="@style/Zezon.Input"
                android:hint="@string/hint_email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/et_phone"
                style="@style/Zezon.Input"
                android:hint="@string/hint_phone"
                android:importantForAutofill="no"
                android:inputType="phone" />

            <EditText
                android:id="@+id/et_password"
                style="@style/Zezon.Input"
                android:hint="@string/hint_password"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/et_confirm_password"
                style="@style/Zezon.Input"
                android:hint="@string/hint_confirm_password"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <!-- Gender: only one option can be selected -->
            <TextView
                android:id="@+id/tv_gender_label"
                style="@style/Zezon.Label"
                android:text="@string/label_gender" />

            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_male"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/gender_male"
                    android:textColor="@color/zezon_navy" />

                <RadioButton
                    android:id="@+id/rb_female"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/gender_female"
                    android:textColor="@color/zezon_navy" />
            </RadioGroup>

            <!-- Programming languages: multiple selections allowed -->
            <TextView
                android:id="@+id/tv_languages_label"
                style="@style/Zezon.Label"
                android:text="@string/label_languages" />

            <LinearLayout
                android:id="@+id/layout_languages_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_java"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/lang_java"
                    android:textColor="@color/zezon_navy" />

                <CheckBox
                    android:id="@+id/cb_kotlin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/lang_kotlin"
                    android:textColor="@color/zezon_navy" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_languages_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_python"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/lang_python"
                    android:textColor="@color/zezon_navy" />

                <CheckBox
                    android:id="@+id/cb_cpp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/zezon_sky_deep"
                    android:text="@string/lang_cpp"
                    android:textColor="@color/zezon_navy" />
            </LinearLayout>

            <!-- Department: one choice from a predefined list -->
            <TextView
                android:id="@+id/tv_department_label"
                style="@style/Zezon.Label"
                android:text="@string/label_department" />

            <Spinner
                android:id="@+id/spinner_department"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:entries="@array/departments"
                android:paddingEnd="8dp"
                android:paddingStart="8dp" />

            <!-- Terms and conditions -->
            <CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:buttonTint="@color/zezon_pink_deep"
                android:text="@string/terms_agree"
                android:textColor="@color/zezon_navy" />

            <!-- Submit -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_sign_up"
                style="@style/Zezon.Button"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_sign_up" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
